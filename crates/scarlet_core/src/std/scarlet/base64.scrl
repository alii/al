/**
 * Base64 as RFC 4648 §4 defines it: the standard alphabet (`A`-`Z`, `a`-`z`,
 * `0`-`9`, `+`, `/`) with `=` padding, so output length is always a multiple
 * of four.
 *
 * This is an encoding, not a cipher — it hides nothing. It is here because the
 * byte-oriented protocols the stdlib already speaks carry binary in text
 * fields: HTTP basic credentials, `data:` URIs, and the WebSocket opening
 * handshake, whose `Sec-WebSocket-Key` and `Sec-WebSocket-Accept` are both
 * base64 (RFC 6455 §1.3).
 *
 * `decode` is strict. It accepts exactly what `encode` produces and rejects
 * everything else: a length that is not a multiple of four, a character
 * outside the alphabet, padding anywhere but the end, and non-zero bits in the
 * discarded tail of a padded group. Strictness is the point — the same bytes
 * decoding two ways is how a signature check is bypassed, so there is
 * deliberately no lenient mode and no whitespace skipping. Callers holding
 * MIME text with line breaks must strip them first.
 */

import scarlet/binary
import scarlet/int

// The alphabet, as arithmetic rather than a table: the five ranges are
// contiguous in ASCII, so a comparison chain maps a 6-bit value to its
// character without allocating a lookup binary per call.
fn digit(v Int) Int {
	if v < 26 {
		// 'A' is 65.
		65 + v
	} else if v < 52 {
		// 'a' is 97, and this range starts at 26.
		71 + v
	} else if v < 62 {
		// '0' is 48, and this range starts at 52.
		v - 4
	} else if v == 62 {
		// '+'
		43
	} else {
		// '/'
		47
	}
}

// The inverse of `digit`, or -1 for any byte outside the alphabet. The
// sentinel is checked at every call site before use; `Option` here would box
// one value per input character for a value that is never stored.
fn undigit(c Int) Int {
	if c >= 65 && c <= 90 {
		c - 65
	} else if c >= 97 && c <= 122 {
		c - 71
	} else if c >= 48 && c <= 57 {
		c + 4
	} else if c == 43 {
		62
	} else if c == 47 {
		63
	} else {
		0 - 1
	}
}

// `b` in base64. Total: every binary has an encoding, and the empty binary
// encodes to the empty binary rather than to padding.
pub fn encode(b Binary) Binary {
	encode_from(b, 0, binary.byte_size(b), <<>>)
}

fn encode_from(b Binary, at Int, size Int, acc Binary) Binary {
	left = size - at
	if left <= 0 {
		acc
	} else if left == 1 {
		b0 = binary.byte_at(b, at)
		// 8 bits into two 6-bit digits: the low 4 bits of the second are the
		// zero fill RFC 4648 §3.5 requires, and `decode` rejects them non-zero.
		d0 = int.bitwise_shift_right(b0, 2)
		d1 = int.bitwise_shift_left(int.bitwise_and(b0, 3), 4)
		binary.append(acc, <<digit(d0):8, digit(d1):8, 61:8, 61:8>>)
	} else if left == 2 {
		b0 = binary.byte_at(b, at)
		b1 = binary.byte_at(b, at + 1)
		d0 = int.bitwise_shift_right(b0, 2)
		d1 = int.bitwise_or(
			int.bitwise_shift_left(int.bitwise_and(b0, 3), 4),
			int.bitwise_shift_right(b1, 4),
		)
		d2 = int.bitwise_shift_left(int.bitwise_and(b1, 15), 2)
		binary.append(acc, <<digit(d0):8, digit(d1):8, digit(d2):8, 61:8>>)
	} else {
		b0 = binary.byte_at(b, at)
		b1 = binary.byte_at(b, at + 1)
		b2 = binary.byte_at(b, at + 2)
		d0 = int.bitwise_shift_right(b0, 2)
		d1 = int.bitwise_or(
			int.bitwise_shift_left(int.bitwise_and(b0, 3), 4),
			int.bitwise_shift_right(b1, 4),
		)
		d2 = int.bitwise_or(
			int.bitwise_shift_left(int.bitwise_and(b1, 15), 2),
			int.bitwise_shift_right(b2, 6),
		)
		d3 = int.bitwise_and(b2, 63)
		next = binary.append(acc, <<digit(d0):8, digit(d1):8, digit(d2):8, digit(d3):8>>)
		encode_from(b, at + 3, size, next)
	}
}

// The bytes `b` encodes, or `Err(Nil)` if `b` is not exactly what `encode`
// produces. See the module doc for what "exactly" rules out.
pub fn decode(b Binary) Result(Binary, Nil) {
	size = binary.byte_size(b)
	if size % 4 != 0 {
		Err(Nil)
	} else {
		decode_from(b, 0, size, <<>>)
	}
}

fn decode_from(b Binary, at Int, size Int, acc Binary) Result(Binary, Nil) {
	if at >= size {
		Ok(acc)
	} else {
		c0 = binary.byte_at(b, at)
		c1 = binary.byte_at(b, at + 1)
		c2 = binary.byte_at(b, at + 2)
		c3 = binary.byte_at(b, at + 3)
		v0 = undigit(c0)
		v1 = undigit(c1)
		// Padding is legal only in the final group, and only in the last two
		// positions. `last` is what makes an interior `=` an error rather than
		// a short decode that silently drops the rest of the input.
		last = at + 4 >= size
		if v0 < 0 || v1 < 0 {
			Err(Nil)
		} else if c2 == 61 {
			// `xx==`: one byte, and the four low bits of v1 must be the fill.
			if !last || c3 != 61 || int.bitwise_and(v1, 15) != 0 {
				Err(Nil)
			} else {
				out = int.bitwise_or(int.bitwise_shift_left(v0, 2), int.bitwise_shift_right(v1, 4))
				Ok(binary.append(acc, <<out:8>>))
			}
		} else if c3 == 61 {
			// `xxx=`: two bytes, and the two low bits of v2 must be the fill.
			v2 = undigit(c2)
			if !last || v2 < 0 || int.bitwise_and(v2, 3) != 0 {
				Err(Nil)
			} else {
				o0 = int.bitwise_or(int.bitwise_shift_left(v0, 2), int.bitwise_shift_right(v1, 4))
				o1 = int.bitwise_or(
					int.bitwise_shift_left(int.bitwise_and(v1, 15), 4),
					int.bitwise_shift_right(v2, 2),
				)
				Ok(binary.append(acc, <<o0:8, o1:8>>))
			}
		} else {
			v2 = undigit(c2)
			v3 = undigit(c3)
			if v2 < 0 || v3 < 0 {
				Err(Nil)
			} else {
				o0 = int.bitwise_or(int.bitwise_shift_left(v0, 2), int.bitwise_shift_right(v1, 4))
				o1 = int.bitwise_or(
					int.bitwise_shift_left(int.bitwise_and(v1, 15), 4),
					int.bitwise_shift_right(v2, 2),
				)
				o2 = int.bitwise_or(int.bitwise_shift_left(int.bitwise_and(v2, 3), 6), v3)
				decode_from(b, at + 4, size, binary.append(acc, <<o0:8, o1:8, o2:8>>))
			}
		}
	}
}
