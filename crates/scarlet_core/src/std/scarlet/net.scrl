import scarlet/net/address.{SocketAddress, IpAddress}
import scarlet/net/socket.{Socket}
import scarlet/net/error.{
	NetError,
	ConnectionAborted,
	ConnectionReset,
	Errno,
	HostUnreachable,
	InvalidPort,
	NetworkDown,
	NetworkUnreachable,
}
import scarlet/result
import scarlet/time.{Instant}
import scarlet/process
import scarlet/process.{Pid, Supervisor, Supervised, Factory, Disposable, Transient, OneForOne}
import scarlet/string

// A TCP server. The value is only ever constructed by the VM, and has no values.
// It's an opaque pointer to the internal value in the VM. See [`al_vm::vm::io::VM::tcp_listen`]
pub type Server

// Bind a listener to an already-resolved address. The port is validated to be
// in 0..=65535 and the bind never blocks the scheduler (the address is already
// an IP literal — no name resolution happens here).
@vm(net__listen)
pub fn listen_addr(addr SocketAddress) Result(Server, NetError)

// Bind a listener to `host:port`. Hostnames are resolved off-scheduler via
// `resolve` before binding, so a name that requires DNS never stalls the
// scheduler thread. IP literals resolve synchronously.
pub fn listen(host String, port Int) Result(Server, NetError) {
	ip <- result.then(resolve(host))
	addr <- result.then(result.replace_err(address.socket_address(ip, port), InvalidPort))
	listen_addr(addr)
}

// Take the next incoming connection off the listener's queue, parking the
// calling process until one arrives. Accept yields the stream of a listener's
// connections, so its three outcomes are an iterator's: `Ok(Some(sock))` is
// the next connection, `Ok(None)` is the end of the stream — the `Server` was
// closed with `close`, which this and every later accept report — and
// `Err(e)` is a kernel accept failure. Shutdown is not an error: an accept
// loop exits on `Ok(None)`.
@vm(net__accept)
pub fn accept(s Server) Result(Option(Socket), NetError)

// A running server: the listener, and the server's place in the process
// tree. `net.close(service.server)` stops accepting — the acceptors end and
// open connections finish on their own; `process.count(service.connections)`
// is the number of connections open right now, and
// `process.children(service.supervised)` shows the acceptors and the
// connection factory, as `serve` declares them.
pub type Service {
	server Server
	supervised Supervised
	connections Supervised
}

// Listen on host:port and serve connections across every CPU core in parallel.
//
// One listening socket, one accept queue, an acceptor on every core: the
// kernel hands each connection to exactly one acceptor, so no core can be
// starved and no connection can be routed where nobody accepts. Every
// connection is handled on the core that accepted it, by `handler`, in a
// process of its own.
//
// The server is a subtree of the process tree, declared under a supervisor
// of its own that `serve` creates for the calling process: a factory whose
// members are the connections — one ends when its handler returns or
// crashes, taking the connection with it and nothing else — and the
// acceptors, restarted on their own cores if one fails; acceptors failing
// faster than a few times a second means the listener is broken, and the
// supervisor gives up as any supervisor does. To place the server inside an
// application's own tree instead, use `serve_in`. A bind failure is `Err`.
pub fn serve(host String, port Int, handler fn(Socket) Nil) Result(Service, NetError) {
	serve_in(process.supervisor(ACCEPTOR_BUDGET), host, port, handler)
}

// As `serve`, declaring the server's subtree inside `sup`, so that it is
// started, stopped and restarted with the rest of the application's tree.
pub fn serve_in(
	sup Supervisor,
	host String,
	port Int,
	handler fn(Socket) Nil,
) Result(Service, NetError) {
	server <- result.then(listen(host, port))
	Ok(serve_on_in(sup, server, handler))
}

// Serve a listener already bound with `listen` — bind on port 0, read the
// port back with `local_addr`, then serve. Nothing here can fail: the bind
// was the fallible step.
pub fn serve_on(server Server, handler fn(Socket) Nil) Service {
	serve_on_in(process.supervisor(ACCEPTOR_BUDGET), server, handler)
}

// As `serve_on`, inside `sup`. The layout every server has:
//
//	sup
//	└─ server        supervisor (acceptor budget)
//	   ├─ connections   factory of disposable members, one per connection
//	   └─ acceptor ×N   transient, one pinned to each core
//
// The factory is declared first, so it is stopped last: stopping the server
// stops accepting before it closes what was accepted.
pub fn serve_on_in(sup Supervisor, server Server, handler fn(Socket) Nil) Service {
	me = process.supervisor_in(sup, ACCEPTOR_BUDGET)
	connections = process.factory(me, Disposable, fn(_inbox, sock) {
		// The connection was accepted by, and so belongs to, the acceptor;
		// it becomes this process's first thing, so that it closes when this
		// process ends — however that happens.
		give(sock, process.self())
		handler(sock)
	})
	process.worker_per_scheduler(me, Transient, fn(_inbox) accept_loop(server, connections))
	Service(server: server, supervised: me.supervised, connections: connections.supervised)
}

// One server's acceptors are its own affair; a listener that cannot accept
// at all makes every acceptor fail at once, which this exhausts within a
// second or two whatever the core count, so the failure surfaces instead of
// being retried for ever.
const ACCEPTOR_BUDGET = OneForOne(restarts: 10, within_ms: 5000)

// Make `to` the process whose end closes `sock`. `to` must be on the core
// that holds the socket — the connection's own handler process, started on
// the core that accepted it, is the one caller.
@vm(net__give)
fn give(sock Socket, to Pid) Nil

// The per-core accept loop: accept a connection, start a member of the
// connection factory for it, loop. A member starts on the core that
// declared it, so the handler begins on the core whose poller holds the
// socket. Every core's acceptor drains the listener's single shared queue —
// spreading the accepts is a locality preference, not a correctness need.
//
// A per-connection accept failure (ECONNABORTED, ECONNRESET, an unmapped errno
// such as EMFILE/EPROTO) means one incoming connection was lost, not that the
// listening socket is dead — the loop retries. ENETDOWN/ENETUNREACH/
// EHOSTUNREACH are per-connection too: accept(2) documents them as
// already-pending errors of the ACCEPTED connection — one that died in the
// queue — not as listener death, so they retry as well. An unmapped errno is
// usually descriptor exhaustion (EMFILE/ENFILE), where accept fails without
// dequeuing anything, so that retry backs off for 100ms first — retrying
// immediately would spin this core at full speed against the same full
// descriptor table. `Ok(None)` is the shutdown a `net.close` delivers to
// parked acceptors: the acceptor returns, which for a transient worker
// means it is done. Any other failure is one this loop has no answer to: it
// is reported, and the acceptor has itself killed, which is how a transient
// worker asks to be restarted — a fresh acceptor on a healthy listener
// carries on; on a broken one the restarts exhaust the server's budget and
// the failure moves up the tree.
fn accept_loop(server Server, connections Factory(Nil, Socket)) Nil {
	match accept(server) {
		Ok(Some(sock)) -> {
			_ = process.start_in(connections, sock)
			accept_loop(server, connections)
		}
		Ok(None) -> Nil
		Err(ConnectionAborted)
		| Err(ConnectionReset)
		| Err(NetworkDown)
		| Err(NetworkUnreachable)
		| Err(HostUnreachable) -> accept_loop(server, connections)
		Err(Errno(_)) -> {
			process.sleep(100)
			accept_loop(server, connections)
		}
		Err(e) -> {
			println('accept failed: ${string.inspect(e)}')
			process.kill(process.self())
		}
	}
}

// Resolve `host` to an `IpAddress`. IP literals pass through unchanged; hostname
// resolution (getaddrinfo) runs on the blocking thread pool so it never stalls
// the scheduler.
@vm(net__resolve)
pub fn resolve(host String) Result(IpAddress, NetError)

// Open a connection to a remote host. `host` may be an IP address or a
// hostname; the hostname is resolved off-scheduler via `resolve`, then the
// connection is established with the calling process parked — neither step
// blocks the scheduler.
//
// This has no bounded sibling, and `connect_addr_within` is the reason: a
// deadline here could not cover the `resolve`, so it would bound one of two
// steps. An IP literal skips resolution entirely, so a caller holding one
// reaches for `connect_addr_within` and gets a deadline over the whole call.
pub fn connect(host String, port Int) Result(Socket, NetError) {
	ip <- result.then(resolve(host))
	addr <- result.then(result.replace_err(address.socket_address(ip, port), InvalidPort))
	connect_addr(addr)
}

// Connect to an already-resolved address. Useful to resolve once and connect
// many times, or to connect to an `IpAddress` obtained elsewhere. The port is
// validated to be in 0..=65535.
@vm(net__connect)
pub fn connect_addr(addr SocketAddress) Result(Socket, NetError)

// Connect to an already-resolved address as `connect_addr`, but wait no longer
// than `timeout_ms` milliseconds. Errs with `TimedOut` once it passes, and the
// half-open connection is dropped rather than left to finish unobserved.
//
// This lowers a ceiling that already exists rather than creating one. An
// unanswered connect does not hang for ever: the kernel gives up on its own —
// measured at 75.0 s on Darwin, the `net.inet.tcp.keepinit` timer — and
// `connect_addr` reports that as `Err(TimedOut)`. A `timeout_ms` above the
// kernel's own is therefore inert. Short deadlines are what this adds.
//
// There is deliberately no `connect_within` taking a host: that would have to
// resolve the name first, and `resolve` has no deadline, so the bound would
// cover only the second of its two steps. `connect_addr_within` takes an
// address because that is the call whose whole work it can actually bound.
pub fn connect_addr_within(addr SocketAddress, timeout_ms Int) Result(Socket, NetError) {
	connect_addr_until(addr, time.add_ms(time.monotonic(), timeout_ms))
}

// Connect as `connect_addr_within`, giving up at the absolute Instant
// `deadline` (from `time.monotonic()`). Use this rather than
// `connect_addr_within` when one deadline covers several steps, so the connect
// gets what is left of the budget instead of a fresh copy of it.
pub fn connect_addr_until(addr SocketAddress, deadline Instant) Result(Socket, NetError) {
	connect_addr_until_ms(addr, time.to_deadline_ms(deadline))
}

@vm(net__connect_until)
fn connect_addr_until_ms(addr SocketAddress, deadline_ms Int) Result(Socket, NetError)

// The address the listener is actually bound to. This is how the kernel-
// assigned port is read back after binding port 0.
@vm(net__local_addr)
pub fn local_addr(s Server) Result(SocketAddress, NetError)

// Shut the listener down. Closing a `Server` wakes every process parked in
// `accept` and makes that call — and every later `accept` — return
// `Ok(None)`, the end-of-stream signal the `serve` acceptors (and any
// hand-rolled accept loop) exit on.
@vm(net__close)
pub fn close(s Server) Result(Nil, NetError)
