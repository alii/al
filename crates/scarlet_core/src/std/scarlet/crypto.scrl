/**
 * Cryptographic primitives a protocol the stdlib speaks names by name.
 *
 * SHA-1 is here ONLY because two of those protocols require it. It is NOT
 * collision-resistant — a chosen-prefix collision has been public since
 * 2017 — so it must never be used for signatures, certificates, password
 * storage, or deduplicating attacker-supplied content. Its one legitimate
 * use is a protocol that specifies it as a fixed handshake constant, where
 * the security argument does not rest on collision resistance: the
 * WebSocket opening handshake (RFC 6455 §1.3), where `Sec-WebSocket-Accept`
 * is `base64(sha1(key <> GUID))` and its job is to prove the server
 * understood the upgrade, not to authenticate anyone.
 *
 * `random_bytes` is the OS CSPRNG. RFC 6455's frame mask and the client's
 * `Sec-WebSocket-Key` have to be unpredictable; a userspace PRNG, even a
 * good one seeded once at boot, is not this function.
 *
 * SHA-256 is the one general-purpose hash here: fine wherever a
 * collision-resistant digest is called for (PKCE's S256 challenge, content
 * addressing), though on its own it is still neither a password hash nor a
 * MAC. Everything said about SHA-1 above stays true: protocol handshakes
 * only.
 */

import scarlet/base64
import scarlet/binary
import scarlet/int

// 2^32 - 1. Every intermediate here is a 32-bit unsigned quantity held in a
// 64-bit signed Int, so each step that can carry past bit 31 masks with this.
// Int has no unsigned counterpart and no 32-bit width, so the masking is the
// only thing keeping the arithmetic inside SHA-1's word size.
const MASK32 = 4294967295

// The RFC 6455 §1.3 handshake constant, appended to the client's
// `Sec-WebSocket-Key` before hashing. Fixed by the spec; not a secret, and not
// a salt.
pub const websocket_guid = <<'258EAFA5-E914-47DA-95CA-C5AB0DC85B11'>>

// SHA-1's five-word chaining state, and the same shape as the working
// variables a-e inside the compression function.
type State {
	a Int
	b Int
	c Int
	d Int
	e Int
}

// Rotate left within 32 bits. `x` must already be masked to 32 bits: the
// right shift is arithmetic, so a value with bit 63 set would smear the sign
// into the bits being rotated in.
fn rotl32(x Int, n Int) Int {
	int.bitwise_and(
		int.bitwise_or(int.bitwise_shift_left(x, n), int.bitwise_shift_right(x, 32 - n)),
		MASK32,
	)
}

// The big-endian 32-bit word at word index `i`. Reads bytes rather than
// slicing so it stays allocation-free: `byte_at` is total and the callers
// below only ever index inside a 64-byte block.
fn word_at(b Binary, i Int) Int {
	at = i * 4
	int.bitwise_or(
		int.bitwise_or(
			int.bitwise_shift_left(binary.byte_at(b, at), 24),
			int.bitwise_shift_left(binary.byte_at(b, at + 1), 16),
		),
		int.bitwise_or(
			int.bitwise_shift_left(binary.byte_at(b, at + 2), 8),
			binary.byte_at(b, at + 3),
		),
	)
}

fn zeros(n Int, acc Binary) Binary {
	if n <= 0 {
		acc
	} else {
		zeros(n - 1, binary.append(acc, <<0:8>>))
	}
}

// The message with SHA-1's padding: a 1 bit (as the byte 128), then zero bits
// until the length is 56 mod 64, then the original length in BITS as a
// big-endian 64-bit integer. The result is always a whole number of 64-byte
// blocks, which is the invariant `blocks` relies on.
fn pad(m Binary) Binary {
	size = binary.byte_size(m)
	rem = { size + 1 } % 64
	fill = if rem <= 56 {
		56 - rem
	} else {
		120 - rem
	}
	bits = size * 8
	binary.append(binary.append(binary.append(m, <<128:8>>), zeros(fill, <<>>)), <<bits:64>>)
}

// One 80-round compression over `win`, the 16-word message schedule window.
//
// At round `i`, `win` holds w[i]..w[i+15], so the round's own word is always
// word 0 and the word appended is w[i+16]. That is the standard rolling-window
// form of the schedule: it keeps 16 words instead of 80, and the last 16
// rounds compute words nothing reads, which is harmless and cheaper than
// branching to avoid it.
fn compress(win Binary, i Int, w State) State {
	if i >= 80 {
		w
	} else {
		f = if i < 20 {
			int.bitwise_or(int.bitwise_and(w.b, w.c), int.bitwise_and(int.bitwise_not(w.b), w.d))
		} else if i < 40 {
			int.bitwise_xor(int.bitwise_xor(w.b, w.c), w.d)
		} else if i < 60 {
			int.bitwise_or(
				int.bitwise_or(int.bitwise_and(w.b, w.c), int.bitwise_and(w.b, w.d)),
				int.bitwise_and(w.c, w.d),
			)
		} else {
			int.bitwise_xor(int.bitwise_xor(w.b, w.c), w.d)
		}
		k = if i < 20 {
			1518500249
		} else if i < 40 {
			1859775393
		} else if i < 60 {
			2400959708
		} else {
			3395469782
		}
		// Five 32-bit addends sum to at most 5 * (2^32 - 1) < 2^35, so the sum
		// cannot reach Int's range before it is masked back to 32 bits.
		t = int.bitwise_and(rotl32(w.a, 5) + f + w.e + k + word_at(win, 0), MASK32)
		next = rotl32(
			int.bitwise_xor(
				int.bitwise_xor(word_at(win, 13), word_at(win, 8)),
				int.bitwise_xor(word_at(win, 2), word_at(win, 0)),
			),
			1,
		)
		compress(
			binary.append(binary.drop_bytes(win, 4), <<next:32>>),
			i + 1,
			State(t, w.a, rotl32(w.b, 30), w.c, w.d),
		)
	}
}

fn blocks(p Binary, at Int, size Int, h State) State {
	if at >= size {
		h
	} else {
		match binary.slice_bytes(p, at, 64) {
			Ok(block) -> {
				w = compress(block, 0, State(h.a, h.b, h.c, h.d, h.e))
				blocks(
					p,
					at + 64,
					size,
					State(
						int.bitwise_and(h.a + w.a, MASK32),
						int.bitwise_and(h.b + w.b, MASK32),
						int.bitwise_and(h.c + w.c, MASK32),
						int.bitwise_and(h.d + w.d, MASK32),
						int.bitwise_and(h.e + w.e, MASK32),
					),
				)
			}
			// Unreachable: `pad` returns a whole number of 64-byte blocks and
			// `at` steps by 64 from 0, so the window is always inside `p`. The
			// arm exists because Result has two of them.
			Err(Nil) -> h
		}
	}
}

// The SHA-1 digest of `m`: 20 bytes, big-endian. Total — every input has a
// digest, including the empty binary.
//
// Read the module doc before reaching for this.
pub fn sha1(m Binary) Binary {
	p = pad(m)
	h = blocks(
		p,
		0,
		binary.byte_size(p),
		State(1732584193, 4023233417, 2562383102, 271733878, 3285377520),
	)
	<<h.a:32, h.b:32, h.c:32, h.d:32, h.e:32>>
}

// The `Sec-WebSocket-Accept` value a server owes for the client's
// `Sec-WebSocket-Key`, per RFC 6455 §4.2.2: base64(sha1(key <> GUID)).
//
// `key` is the raw header value as it appeared on the wire, still base64 — it
// is concatenated as text and is NOT decoded first. A client compares this
// against the header it received; a client that skips the comparison accepts
// any server that answers 101.
pub fn websocket_accept(key Binary) Binary {
	base64.encode(sha1(binary.append(key, websocket_guid)))
}

// `n` bytes from the OS CSPRNG (`getrandom` / equivalent). `Err(Nil)` if
// `n` is negative or the host source fails. Never a userspace generator,
// and never silent zeros (or any other stand-in) on failure.
@vm(crypto__random_bytes)
pub fn random_bytes(n Int) Result(Binary, Nil)


// SHA-256's eight-word chaining state, and the working variables a-h inside
// its compression function.
type State256 {
	a Int
	b Int
	c Int
	d Int
	e Int
	f Int
	g Int
	h Int
}

// Rotate right within 32 bits. Same masking argument as `rotl32`: `x` is
// already 32-bit clean, so the arithmetic right shift cannot smear a sign.
fn rotr32(x Int, n Int) Int {
	int.bitwise_and(
		int.bitwise_or(int.bitwise_shift_right(x, n), int.bitwise_shift_left(x, 32 - n)),
		MASK32,
	)
}

// FIPS 180-4's 64 round constants, packed as big-endian words so `word_at`
// can index them the way it indexes a message block — the stdlib has no
// constant integer arrays, but it does have constant binaries.
const K256 = <<
	1116352408:32, 1899447441:32, 3049323471:32, 3921009573:32,
	961987163:32, 1508970993:32, 2453635748:32, 2870763221:32,
	3624381080:32, 310598401:32, 607225278:32, 1426881987:32,
	1925078388:32, 2162078206:32, 2614888103:32, 3248222580:32,
	3835390401:32, 4022224774:32, 264347078:32, 604807628:32,
	770255983:32, 1249150122:32, 1555081692:32, 1996064986:32,
	2554220882:32, 2821834349:32, 2952996808:32, 3210313671:32,
	3336571891:32, 3584528711:32, 113926993:32, 338241895:32,
	666307205:32, 773529912:32, 1294757372:32, 1396182291:32,
	1695183700:32, 1986661051:32, 2177026350:32, 2456956037:32,
	2730485921:32, 2820302411:32, 3259730800:32, 3345764771:32,
	3516065817:32, 3600352804:32, 4094571909:32, 275423344:32,
	430227734:32, 506948616:32, 659060556:32, 883997877:32,
	958139571:32, 1322822218:32, 1537002063:32, 1747873779:32,
	1955562222:32, 2024104815:32, 2227730452:32, 2361852424:32,
	2428436474:32, 2756734187:32, 3204031479:32, 3329325298:32
>>

// One 64-round SHA-256 compression over `win`, the 16-word rolling schedule
// window: the round's own word is word 0, and the appended word is w[i+16] =
// w[i] + s0(w[i+1]) + w[i+9] + s1(w[i+14]). As with SHA-1, the final rounds
// extend the schedule past anything a round reads; computing them is cheaper
// than branching to avoid it.
fn compress256(win Binary, i Int, w State256) State256 {
	if i >= 64 {
		w
	} else {
		e_sigma = int.bitwise_xor(int.bitwise_xor(rotr32(w.e, 6), rotr32(w.e, 11)), rotr32(w.e, 25))
		ch = int.bitwise_xor(int.bitwise_and(w.e, w.f), int.bitwise_and(int.bitwise_not(w.e), w.g))
		// Five 32-bit addends again: bounded by 2^35, masked back to 32.
		t1 = int.bitwise_and(w.h + e_sigma + ch + word_at(K256, i) + word_at(win, 0), MASK32)
		a_sigma = int.bitwise_xor(int.bitwise_xor(rotr32(w.a, 2), rotr32(w.a, 13)), rotr32(w.a, 22))
		maj = int.bitwise_xor(
			int.bitwise_xor(int.bitwise_and(w.a, w.b), int.bitwise_and(w.a, w.c)),
			int.bitwise_and(w.b, w.c),
		)
		t2 = int.bitwise_and(a_sigma + maj, MASK32)
		s0 = int.bitwise_xor(
			int.bitwise_xor(rotr32(word_at(win, 1), 7), rotr32(word_at(win, 1), 18)),
			int.bitwise_shift_right(word_at(win, 1), 3),
		)
		s1 = int.bitwise_xor(
			int.bitwise_xor(rotr32(word_at(win, 14), 17), rotr32(word_at(win, 14), 19)),
			int.bitwise_shift_right(word_at(win, 14), 10),
		)
		next = int.bitwise_and(word_at(win, 0) + s0 + word_at(win, 9) + s1, MASK32)
		compress256(
			binary.append(binary.drop_bytes(win, 4), <<next:32>>),
			i + 1,
			State256(
				int.bitwise_and(t1 + t2, MASK32),
				w.a,
				w.b,
				w.c,
				int.bitwise_and(w.d + t1, MASK32),
				w.e,
				w.f,
				w.g,
			),
		)
	}
}

fn blocks256(p Binary, at Int, size Int, h State256) State256 {
	if at >= size {
		h
	} else {
		match binary.slice_bytes(p, at, 64) {
			Ok(block) -> {
				w = compress256(block, 0, State256(h.a, h.b, h.c, h.d, h.e, h.f, h.g, h.h))
				blocks256(
					p,
					at + 64,
					size,
					State256(
						int.bitwise_and(h.a + w.a, MASK32),
						int.bitwise_and(h.b + w.b, MASK32),
						int.bitwise_and(h.c + w.c, MASK32),
						int.bitwise_and(h.d + w.d, MASK32),
						int.bitwise_and(h.e + w.e, MASK32),
						int.bitwise_and(h.f + w.f, MASK32),
						int.bitwise_and(h.g + w.g, MASK32),
						int.bitwise_and(h.h + w.h, MASK32),
					),
				)
			}
			// Unreachable for the same reason as SHA-1's: `pad` emits whole
			// 64-byte blocks and `at` steps by 64 from 0.
			Err(Nil) -> h
		}
	}
}

// The SHA-256 digest of `m`: 32 bytes, big-endian. Total — every input has a
// digest, including the empty binary.
//
// Unlike SHA-1 above, this one is fine to reach for on its own merits:
// collision-resistant as far as anyone knows, and the hash OAuth's PKCE
// (S256), TLS 1.3, and most content addressing specify. SHA-256 alone is
// still not a password hash and not a MAC — it needs a KDF or HMAC on top
// for those jobs.
pub fn sha256(m Binary) Binary {
	p = pad(m)
	h = blocks256(
		p,
		0,
		binary.byte_size(p),
		State256(
			1779033703,
			3144134277,
			1013904242,
			2773480762,
			1359893119,
			2600822924,
			528734635,
			1541459225,
		),
	)
	<<h.a:32, h.b:32, h.c:32, h.d:32, h.e:32, h.f:32, h.g:32, h.h:32>>
}
