// Integer bitwise ops: and, or, xor, not, and the two shifts.
//
// Int is a 64-bit signed two's-complement integer, so all six operate on 64
// bits and the sign bit is an ordinary bit that happens to carry the sign.
// Like the arithmetic ops they are TOTAL — every input has a defined answer
// and nothing traps. The edges this pins are the ones where implementations
// quietly disagree with each other:
//
//   shift count >= 64   shifts every bit out (0, or the sign for `shift_right`).
//                       It is NOT masked to 6 bits as C and most hardware shift
//                       instructions do, so `shift_left(1, 64)` is 0, not 1.
//   negative count      shifts the other way by the same magnitude.
//   shift_right         is ARITHMETIC: the sign propagates, so a negative value
//                       never becomes positive.
//   bitwise_not         complements the sign bit too, so `not 0 == -1`.
//
// Scarlet has no hex literals, so every mask here is written in decimal; the
// comment gives the hex where that is what makes the value readable.

import scarlet/int

fn ok(b Bool) String {
	if b { 'PASS' } else { 'FAIL' }
}

pub fn main() {
	// 2^47 - 1 is the largest unboxed small Int. Crossing it boxes the value, and
	// no bitwise op may notice.
	small_max = 140737488355327

	// --- The basics -----------------------------------------------------------

	println(
		'and: ${int.bitwise_and(12, 10)} ${int.bitwise_and(255, 15)} ${int.bitwise_and(0, 12345)}',
	)
	println('or: ${int.bitwise_or(12, 10)} ${int.bitwise_or(240, 15)} ${int.bitwise_or(0, 12345)}')
	println(
		'xor: ${int.bitwise_xor(12, 10)} ${int.bitwise_xor(255, 15)} ${int.bitwise_xor(0, 12345)}',
	)
	println(
		'not: ${int.bitwise_not(
			0,
		)} ${int.bitwise_not(1)} ${int.bitwise_not(-1)} ${int.bitwise_not(255)}',
	)

	// --- Identities -----------------------------------------------------------

	// `and` with 0 clears, `and` with -1 (all bits set) is identity; `or` mirrors it.
	println(
		'and identity: ${ok(
			int.bitwise_and(12345, -1) == 12345,
		)} ${ok(int.bitwise_and(12345, 0) == 0)}',
	)
	println(
		'or identity: ${ok(
			int.bitwise_or(12345, 0) == 12345,
		)} ${ok(int.bitwise_or(12345, -1) == -1)}',
	)

	// XOR of a value with itself is 0 — including for the values most likely to be
	// special-cased: the bounds, the sign bit alone, and a boxed value.
	println(
		'xor self: ${ok(
			int.bitwise_xor(12345, 12345) == 0,
		)} ${ok(
			int.bitwise_xor(int.max_value, int.max_value) == 0,
		)} ${ok(
			int.bitwise_xor(int.min_value, int.min_value) == 0,
		)} ${ok(int.bitwise_xor(small_max + 1, small_max + 1) == 0)}',
	)
	println(
		'xor zero: ${ok(
			int.bitwise_xor(12345, 0) == 12345,
		)} ${ok(int.bitwise_xor(int.min_value, 0) == int.min_value)}',
	)

	// `not` round-trips, and equals `0 - n - 1` on every value including the bounds
	// (where that arithmetic wraps and must still agree).
	println(
		'not round trip: ${ok(
			int.bitwise_not(int.bitwise_not(12345)) == 12345,
		)} ${ok(
			int.bitwise_not(int.bitwise_not(int.min_value)) == int.min_value,
		)} ${ok(int.bitwise_not(int.bitwise_not(int.max_value)) == int.max_value)}',
	)
	println(
		'not is -n-1: ${ok(
			int.bitwise_not(7) == 0 - 7 - 1,
		)} ${ok(
			int.bitwise_not(int.min_value) == int.max_value,
		)} ${ok(int.bitwise_not(int.max_value) == int.min_value)}',
	)

	// De Morgan, over the sign boundary.
	println(
		'de morgan: ${ok(
			int.bitwise_not(int.bitwise_and(12345, 6789)) ==
			int.bitwise_or(int.bitwise_not(12345), int.bitwise_not(6789)),
		)} ${ok(
			int.bitwise_not(int.bitwise_or(-12345, 6789)) ==
			int.bitwise_and(int.bitwise_not(-12345), int.bitwise_not(6789)),
		)}',
	)

	// --- The sign bit ---------------------------------------------------------

	// Bit 63 alone is int.min_value, so shifting 1 into it lands exactly there.
	println(
		'sign bit: ${ok(
			int.bitwise_shift_left(1, 63) == int.min_value,
		)} ${ok(
			int.bitwise_and(int.min_value, int.max_value) == 0,
		)} ${ok(int.bitwise_or(int.min_value, int.max_value) == -1)}',
	)
	println(
		'sign test: ${ok(
			int.bitwise_and(-1, int.min_value) == int.min_value,
		)} ${ok(int.bitwise_and(1, int.min_value) == 0)}',
	)

	// --- Shifting by zero -----------------------------------------------------

	println(
		'shl 0: ${ok(
			int.bitwise_shift_left(12345, 0) == 12345,
		)} ${ok(
			int.bitwise_shift_left(int.min_value, 0) == int.min_value,
		)} ${ok(int.bitwise_shift_left(-1, 0) == -1)}',
	)
	println(
		'shr 0: ${ok(
			int.bitwise_shift_right(12345, 0) == 12345,
		)} ${ok(
			int.bitwise_shift_right(int.min_value, 0) == int.min_value,
		)} ${ok(int.bitwise_shift_right(-1, 0) == -1)}',
	)

	// --- Shifting by the full width, and past it ------------------------------

	// The masking trap: a 6-bit-masked count would make `shift_left(1, 64)` == 1.
	println(
		'shl 64: ${int.bitwise_shift_left(
			1,
			64,
		)} ${int.bitwise_shift_left(
			1,
			65,
		)} ${int.bitwise_shift_left(-1, 64)} ${int.bitwise_shift_left(int.max_value, 100)}',
	)
	println(
		'shl width edge: ${ok(
			int.bitwise_shift_left(1, 63) == int.min_value,
		)} ${ok(
			int.bitwise_shift_left(1, 64) == 0,
		)} ${ok(int.bitwise_shift_left(1, int.max_value) == 0)}',
	)

	// Right shift past the width leaves the SIGN, not zero: 0 for non-negative,
	// -1 for negative.
	println(
		'shr 64: ${int.bitwise_shift_right(
			int.max_value,
			64,
		)} ${int.bitwise_shift_right(
			-1,
			64,
		)} ${int.bitwise_shift_right(int.min_value, 64)} ${int.bitwise_shift_right(1, 100)}',
	)
	println(
		'shr width edge: ${ok(
			int.bitwise_shift_right(int.min_value, 63) == -1,
		)} ${ok(
			int.bitwise_shift_right(int.min_value, 64) == -1,
		)} ${ok(
			int.bitwise_shift_right(-1, int.max_value) == -1,
		)} ${ok(int.bitwise_shift_right(int.max_value, int.max_value) == 0)}',
	)

	// --- Arithmetic, not logical ----------------------------------------------

	// A logical shift would make the first of these a large positive number.
	println(
		'shr arithmetic: ${int.bitwise_shift_right(
			-8,
			1,
		)} ${int.bitwise_shift_right(
			8,
			1,
		)} ${int.bitwise_shift_right(-1, 1)} ${int.bitwise_shift_right(int.min_value, 1)}',
	)
	println(
		'shr keeps sign: ${ok(
			int.bitwise_shift_right(-8, 1) == -4,
		)} ${ok(int.bitwise_shift_right(-1, 62) == -1)}',
	)

	// Masking first is how a caller gets logical behaviour out of a signed shift.
	println('logical via mask: ${int.bitwise_shift_right(int.bitwise_and(-1, 255), 4)}')

	// --- Negative shift counts ------------------------------------------------

	// A negative count shifts the other way by the same magnitude, so the two
	// functions are reflections of each other.
	println(
		'negative count: ${ok(
			int.bitwise_shift_left(8, -1) == int.bitwise_shift_right(8, 1),
		)} ${ok(
			int.bitwise_shift_right(8, -1) == int.bitwise_shift_left(8, 1),
		)} ${ok(int.bitwise_shift_left(-8, -1) == -4)}',
	)

	// int.min_value has no positive negation; saturating lands past the width,
	// which is the same answer the exact magnitude would give.
	println(
		'most negative count: ${ok(
			int.bitwise_shift_left(1, int.min_value) == 0,
		)} ${ok(
			int.bitwise_shift_left(-1, int.min_value) == -1,
		)} ${ok(
			int.bitwise_shift_right(1, int.min_value) == 0,
		)} ${ok(int.bitwise_shift_right(-1, int.min_value) == 0)}',
	)

	// --- Boxing must be invisible ---------------------------------------------

	boxed = small_max + 1
	println(
		'boxed: ${ok(
			int.bitwise_and(boxed, boxed) == boxed,
		)} ${ok(
			int.bitwise_xor(boxed, boxed) == 0,
		)} ${ok(
			int.bitwise_shift_right(boxed, 1) == 70368744177664,
		)} ${ok(int.bitwise_shift_left(small_max, 1) == 281474976710654)}',
	)
	println(
		'boxed not: ${ok(
			int.bitwise_not(int.bitwise_not(boxed)) == boxed,
		)} ${ok(int.bitwise_or(boxed, 0) == boxed)}',
	)

	// --- What the port actually needs -----------------------------------------

	// A permission bitfield: set, test and clear a flag by its bit index.
	perms = int.bitwise_or(int.bitwise_shift_left(1, 3), int.bitwise_shift_left(1, 40))
	println(
		'bitfield: ${perms} ${ok(
			int.bitwise_and(perms, int.bitwise_shift_left(1, 3)) != 0,
		)} ${ok(int.bitwise_and(perms, int.bitwise_shift_left(1, 4)) == 0)}',
	)
	cleared = int.bitwise_and(perms, int.bitwise_not(int.bitwise_shift_left(1, 3)))
	println(
		'bitfield clear: ${cleared} ${ok(
			int.bitwise_and(cleared, int.bitwise_shift_left(1, 3)) == 0,
		)} ${ok(int.bitwise_and(cleared, int.bitwise_shift_left(1, 40)) != 0)}',
	)

	// WebSocket frame masking (RFC 6455): payload XOR key, and XOR by the same key
	// again returns the original byte. 3735928559 is 0xDEADBEEF.
	key = 3735928559
	mask_byte = int.bitwise_and(int.bitwise_shift_right(key, 24), 255)
	masked = int.bitwise_xor(200, mask_byte)
	println('ws mask: ${mask_byte} ${masked} ${ok(int.bitwise_xor(masked, mask_byte) == 200)}')

	// Extracting each of the four key bytes, high to low.
	b0 = int.bitwise_and(int.bitwise_shift_right(key, 24), 255)
	b1 = int.bitwise_and(int.bitwise_shift_right(key, 16), 255)
	b2 = int.bitwise_and(int.bitwise_shift_right(key, 8), 255)
	b3 = int.bitwise_and(key, 255)
	println('key bytes: ${b0} ${b1} ${b2} ${b3}')
	println(
		'key rebuilt: ${ok(
			int.bitwise_or(
				int.bitwise_shift_left(b0, 24),
				int.bitwise_or(
					int.bitwise_shift_left(b1, 16),
					int.bitwise_or(int.bitwise_shift_left(b2, 8), b3),
				),
			) ==
			key,
		)}',
	)
}
