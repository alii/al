// Message passing with scarlet/process Subjects. Everything here is pinned
// as a derived fact: interleavings across senders are not deterministic, so
// multi-sender traffic is asserted as an aggregate, and every sequenced line
// rides a request/reply handshake that forces the order it prints in.

import scarlet/process
import scarlet/process.{Subject}

fn check(name String, expected Bool, actual Bool) Nil {
	if expected == actual {
		println('PASS ${name}')
	} else {
		println('FAIL ${name}: expected ${expected}, got ${actual}')
	}
}

// --- receive_within -----------------------------------------------------------
// A quiet subject times out with Err(Nil); a served one returns Ok before the
// deadline.

fn wait_quiet(s Subject(Int)) String {
	match process.receive_within(s, 30) {
		Ok(_) -> 'message'
		Err(Nil) -> 'timeout'
	}
}

// --- a server process: sum type in, reply subjects out ------------------------
// The server owns its inbox, so it creates it itself and hands the handle back
// through a bootstrap subject. Stop proves the mailbox drains in order.

type Msg {
	Add(n Int, reply Subject(Int))
	Stop(done Subject(String))
}

fn serve(inbox Subject(Msg), total Int) Nil {
	match process.receive(inbox) {
		Add(n, reply) -> {
			process.send(reply, total + n)
			serve(inbox, total + n)
		}
		Stop(done) -> process.send(done, 'served ${total}')
	}
}

// --- many senders, one aggregate ----------------------------------------------
// Arrival order across processes is unspecified; the sum is not.

fn shout(out Subject(Int), base Int) Nil {
	process.send(out, base)
	process.send(out, base * 2)
}

fn drain(s Subject(Int), left Int, acc Int) Int {
	if left == 0 {
		acc
	} else {
		drain(s, left - 1, acc + process.receive(s))
	}
}

// --- a subject-returning function stays generic ---------------------------------
// The value restriction pins a live subject's message type (see unsound.rs
// U24), but a function builds a fresh subject per call, so it stays
// polymorphic.

fn fresh() Subject(msg) {
	process.subject()
}

pub fn main() {
	// --- identity and FIFO on one subject -----------------------------------------
	// A subject equals only itself, and messages from one sender arrive in order.

	inbox = process.subject()
	process.send(inbox, 1)
	process.send(inbox, 2)
	process.send(inbox, 3)
	check('subject eq self', True, inbox == inbox)
	check('fifo first', True, process.receive(inbox) == 1)
	check('fifo second', True, process.receive(inbox) == 2)
	check('fifo third', True, process.receive(inbox) == 3)

	// --- payloads are copied whole ------------------------------------------------
	// A message is deep-copied at send; structure and equality survive the trip.

	parcels = process.subject()
	process.send(parcels, (7, 'seven', [1, 2, 3]))
	check('structured payload', True, process.receive(parcels) == (7, 'seven', [1, 2, 3]))

	blobs = process.subject()
	process.send(blobs, <<1, 2, 3>>)
	check('binary payload', True, process.receive(blobs) == <<1, 2, 3>>)

	// --- a blocking receive parks, a send wakes -----------------------------------
	// The child sleeps first, so main is parked in receive when the send lands.

	wake = process.subject()
	_ = process.spawn(fn() {
		process.sleep(10)
		process.send(wake, 'from the child')
	})
	println('cross-process: ${process.receive(wake)}')

	check('receive_within times out', True, wait_quiet(process.subject()) == 'timeout')

	slowpoke = process.subject()
	_ = process.spawn(fn() {
		process.sleep(10)
		process.send(slowpoke, 7)
	})
	check('receive_within delivers', True, process.receive_within(slowpoke, 5000) == Ok(7))

	boot = process.subject()
	_ = process.spawn(fn() {
		server_inbox = process.subject()
		process.send(boot, server_inbox)
		serve(server_inbox, 0)
	})
	server = process.receive(boot)

	reply = process.subject()
	process.send(server, Add(5, reply))
	println('add 5 -> ${process.receive(reply)}')
	process.send(server, Add(37, reply))
	println('add 37 -> ${process.receive(reply)}')

	done = process.subject()
	process.send(server, Stop(done))
	println('stop -> ${process.receive(done)}')

	tally = process.subject()
	_ = process.spawn(fn() shout(tally, 10))
	_ = process.spawn(fn() shout(tally, 100))
	_ = process.spawn(fn() shout(tally, 1000))
	check('every send arrives', True, drain(tally, 6, 0) == 3330)

	ints = fresh()
	texts = fresh()
	process.send(ints, 1)
	process.send(texts, 'text')
	println('fresh subjects: ${process.receive(ints)} ${process.receive(texts)}')

	// --- a subject dies with its owner --------------------------------------------
	// The child hands its own subject out and finishes; a later send to it is
	// dropped, not an error.

	graveyard = process.subject()
	_ = process.spawn(fn() process.send(graveyard, process.subject()))
	orphan = process.receive(graveyard)
	process.sleep(30)
	process.send(orphan, 99)
	println('send to a dead subject: ok')
}
