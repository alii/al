-- parse and read on demand --
kind          ObjectKind
size          3
a             Some(1)
b.0           Some(True)
b.1 is null   True
c.d           Some(2.5)
missing       True
kind of null  Some(NullKind)

-- absent, null and present are three states --
held          Some(lovelace)
after absent  Some(lovelace)
after null    None
after present Some(count)
state {}      absent
state {k:null}null
state {k:v}   present(count)
{} != {k:null}True

-- typed records --
null nick     User{ id: 1070000000000000001, name: ada, bot: False, nickname: Null }
absent nick   User{ id: 1070000000000000001, name: ada, bot: False, nickname: Absent }
set nick      User {
  id: 1070000000000000001,
  name: ada,
  bot: True,
  nickname: Present(c)
}

